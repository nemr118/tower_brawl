__pycache__/
patch_*.py
fix*.py

# versioned web builds are 20 MB each; only the plain export is tracked
build/web/index_v*

# Godot editor cache and runtime logs never belong in git
.godot/
debug.log
server.log
*.log
.harness_logs/

# live status file written by serve_game.py once a second
status.json
status.json.tmp

# live harness state file written by tools/chaos_bots.py while a run is on
harness_state.json
harness_state.json.tmp

# text snapshots saved from tools/watch_server.py with the s key
deck_snapshot_*.txt

# v0.0.37: every client card and match marker, appended by serve_game.py (rotates to .1 at 10 MB)
client_stats.jsonl*

# v0.0.40: the laptop bot manager (tools/tbbot.py) pid and log files, and playtest data pulled off the laptop
.bots/
playtest_logs/
