; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited directly.

config_version=5

[application]

config/name="TowerBrawl"
config/description="TowerFall x Brawlhalla style party brawler for family and friends"
config/version="1.0.0"
run/main_scene="res://scenes/arena.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.08, 0.08, 0.12, 1)

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Players"
2d_physics/layer_3="Projectiles"
2d_physics/layer_4="Pickups"
2d_physics/layer_5="Hazards"

