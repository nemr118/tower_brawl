; Tower Brawl, the new game (P1, 2026-10-10), grown from the 8-player benchmark.
; Its own Godot project, so the brawler's autoloads (Global) never start.
; The server, headless:  godot --headless --path bench res://server/game_server.tscn
; The client in a window: godot --path bench -- --server=wss://127.0.0.1:8091 --name=Dad
; The web page: tools/v2_build.sh (build/web/v2/). The old benchmark page: ?bench.
config_version=5

[application]

config/name="Tower Brawl"
run/main_scene="res://client/game_client.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.04, 0.02, 0.08, 1)
boot_splash/fullsize=true
boot_splash/image="res://assets/splash.png"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.035, 1)
